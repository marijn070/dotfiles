// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "unbind": {
      "ctrl-w": "workspace::CloseActiveDock",
    },
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-[": "pane::ActivatePreviousItem",
      "ctrl-]": "pane::ActivateNextItem",
      "ctrl-m": "workspace::ToggleZoom",
      // for whichkey to work
      "space": null,
    },
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "bindings": {
      "space t": "workspace::ToggleBottomDock",
      "space w m": "workspace::ToggleZoom",
      "space w H": "workspace::ToggleLeftDock",
      "space w J": "workspace::ToggleBottomDock",
      "space w L": "workspace::ToggleRightDock",
      "space e": "vim::ToggleProjectPanelFocus",
      "space A": "agent::ToggleFocus",
      "space g": [
        "task::Spawn",
        {
          "task_name": "lazygit",
          "reveal_target": "center",
        },
      ],
    },
  },
  {
    "context": "vim_mode == helix_normal && MessageEditor",
    "bindings": {
      "space w q": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "space w q": "workspace::CloseActiveDock",
      "space e": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-t": "workspace::NewTerminal",
      "ctrl-w": "pane::CloseActiveItem",
      "ctrl-[": "pane::ActivatePreviousItem",
      "ctrl-]": "pane::ActivateNextItem",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-w": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false,
        },
      ],
    },
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-backspace": ["terminal::SendKeystroke", "ctrl-w"],
    },
  },
  {
    "context": "ProjectPanel && !editing",
    "bindings": {
      "shift-c": "project_panel::Duplicate",
    },
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select || vim_mode == visual) && !menu",
    "bindings": {
      "space c": "editor::ToggleComments",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-n": "workspace::NewFile",
    },
  },
  {
    "context": "Workspace && !Terminal",
    "bindings": {
      "ctrl-p": "file_finder::Toggle",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-p": "file_finder::Toggle",
    },
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select || vim_mode == visual) && !menu",
    "bindings": {
      "s": "vim::HelixSelectRegex",
    },
  },
  {
    "bindings": {
      "alt-)": "editor::RotateSelectionsForward",
    },
  },
  {
    "bindings": {
      "alt-(": "editor::RotateSelectionsBackward",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-backspace": [
        "editor::DeleteToPreviousWordStart",
        {
          "ignore_newlines": false,
          "ignore_brackets": false,
        },
      ],
    },
  },
]
