[Unit]
Description=Thunderbird calendar sync (NuShell)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/nu %h/.config/omarchy/plugins/marijn070.calendar-thunderbird/sync/thunderbird_sync/mod.nu
TimeoutSec=120
Restart=no
StandardOutput=journal
StandardError=journal
