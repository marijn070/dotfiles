{
  "bar": {
    "centerAnchor": "tmn73.calendar",
    "layout": {
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "tmn73.calendar",
          "format": "dddd HH:mm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omamail",
          "refreshIntervalSec": 120,
          "maxMessages": 25,
          "heavyMessageRendering": "Show plain text first",
          "contentDirection": "Auto",
          "defaultQuery": "in:inbox",
          "notifyNewMail": "On",
          "oauthPort": 9481,
          "undoSendSeconds": 10,
          "unifiedCalendarView": false,
          "showBarIcon": true,
          "unifiedMailboxes": true,
          "previewOnCursor": false,
          "markReadDelaySec": 2
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "org.ren.caldir"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "io.github.thetrueferret.decent-workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "marijn.zotero"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "akitaonrails.ai-usagebar",
          "lastSelectedEntryId": "openai"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "im0001gt.hw-tooltip"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "flip"
    },
    {
      "id": "meviusisback.keybinds"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer"
  ]
}
