#!/usr/bin/env fish

# --- CONFIGURATION ---
# Define paths for templates and output directories
set TEMPLATE_PATH ~/Documents/DUKTEEP/Declaraties/template.xltx

set MONTH_NAME (env LC_TIME=nl_NL.UTF-8 date -d "last month" +%B)
set MONTH_NR (env LC_TIME=nl_NL.UTF-8 date -d "last month" +%m)
set YEAR (date -d "last month" +%Y)

# Set up output file paths based on the month
set OUTPUT_DIR ~/Documents/DUKTEEP/Declaraties/$YEAR/$MONTH_NR-$MONTH_NAME
set NEW_NAME "$OUTPUT_DIR/declaratieformulier_marijn_$MONTH_NAME"
set NEW_XLSX "$NEW_NAME.xlsx"
set NEW_PDF "$NEW_NAME.pdf"
set MERGED_PDF "$OUTPUT_DIR/declaraties_$MONTH_NAME.pdf"
set ONLYOFFICE_CMD onlyoffice-desktopeditors

# --- STEP 1: Ensure directory exists ---
# Create the output directory if it doesn't already exist
mkdir -p $OUTPUT_DIR

# --- STEP 2: Create or open XLSX ---
# Check if the spreadsheet for the previous month already exists
if test -f $NEW_XLSX
    echo "Opening existing spreadsheet: $NEW_XLSX"
else
    # Copy the template to create a new spreadsheet
    cp $TEMPLATE_PATH $NEW_XLSX
    echo "Created new spreadsheet: $NEW_XLSX"
end

# Open the spreadsheet for editing
$ONLYOFFICE_CMD $NEW_XLSX

# --- STEP 3: Export to PDF ---
# Convert the spreadsheet to PDF using LibreOffice if the PDF doesn't exist yet
if not test -f $NEW_PDF
    soffice --headless --convert-to pdf $NEW_XLSX --outdir $OUTPUT_DIR
    echo "Exported to PDF: $NEW_PDF"
end

# --- STEP 4: Gather additional PDFs ---
# Prompt the user to select any additional PDFs (e.g., receipts) to merge
set ADDITIONAL_PDFS (zenity --file-selection --multiple --file-filter="*.pdf" --title="Select PDFs to merge")
set FILES_TO_MERGE $NEW_PDF

# If the user selected additional PDFs, copy them to the output directory
if test -n "$ADDITIONAL_PDFS"
    for pdf in (string split "|" $ADDITIONAL_PDFS)
        cp $pdf $OUTPUT_DIR/
    end
end

# Find all PDFs in the output directory (excluding the main declaration PDF) and add them to the merge list
for pdf in $OUTPUT_DIR/*.pdf
    if test "$pdf" != "$NEW_PDF"
        set -a FILES_TO_MERGE $pdf
    end
end

# --- STEP 5: Merge PDFs ---
# Combine the main PDF and any additional PDFs into a single file
if not test -f $MERGED_PDF
    pdfunite $FILES_TO_MERGE $MERGED_PDF
    echo "Merged PDF created at: $MERGED_PDF"
end

# --- STEP 6: Email the merged PDF ---
# Open Thunderbird to compose an email with the merged PDF attached
thunderbird -compose "from=marijn@marijnsklusjes.nl,subject=declaratie marijn $MONTH_NAME,attachment=$MERGED_PDF"
