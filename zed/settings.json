// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  // --- Font ---
  "agent_servers": {
    "github-copilot-cli": {
      "default_config_options": {
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent",
        "allow_all": "on"
      },
      "type": "registry"
    }
  },
  "buffer_font_family": "Iosevka Nerd Font",
  "buffer_font_size": 16.0,
  "buffer_font_weight": 400.0,
  "ui_font_family": "Iosevka Aile",
  "ui_font_size": 15.0,
  "ui_font_weight": 450.0,
  "agent_buffer_font_size": 15.0,
  "agent_ui_font_size": 16.0,
  // --- Theme & Icons ---
  "theme": {
    "mode": "light",
    "light": "Omazed",
    "dark": "Everforest",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark"
  },
  // --- Editor ---
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 8,
  "soft_wrap": "editor_width",
  "diff_view_style": "unified",
  "format_on_save": "on",
  "semantic_tokens": "combined",
  "inlay_hints": {
    "enabled": true,
  },
  "prettier": {
    "allowed": false
  },
  // --- UI Panels ---
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 20.0,
    "folder_icons": true,
    "file_icons": true,
    "entry_spacing": "standard",
  },
  "git_panel": {
    "dock": "right",
  },
  // --- Agent ---
  "agent": {
    "tool_permissions": {
      "tools": {
        "open": {
          "default": "allow",
        },
      },
      "default": "allow",
    },
    "single_file_review": true,
    "inline_assistant_model": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
    },
    "default_profile": "write",
    "dock": "right",
    "default_model": {
      "enable_thinking": true,
      "provider": "google",
      "model": "gemini-2.5-flash",
    },
  },
  // --- Edit Predictions ---
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
  },
  // --- Terminal ---
  "terminal": {
    "font_size": 16.0,
    "font_family": "IosevkaTerm Nerd Font Mono",
    "cursor_shape": "block",
    "line_height": "standard",
    "dock": "bottom",
    "shell": {
      "program": "fish",
    },
    "working_directory": "current_project_directory",
    "detect_venv": {
      "on": {
        "directories": [
          ".venv",
          "venv"
        ],
        "activate_script": "fish",
      },
    },
  },
  // --- Keymaps & Behaviour ---
  "base_keymap": "VSCode",
  "cli_default_open_behavior": "new_window",
  "which_key": {
    "enabled": true,
  },
  // --- Extensions ---
  "auto_update_extensions": {
    "iwe": false,
  },
  // --- Languages ---
  "language_models": {},
  "file_types": {},
  "languages": {
    "SQL": {
      "tab_size": 4
    },
    "Lua": {
      "tab_size": 4
    },
    "Shell Script": {
      "tab_size": 4
    },
    "YAML": {
      "hard_tabs": false,
      "tab_size": 2,
      "formatter": "language_server"
    },
    "XML": {
      "preferred_line_length": 99,
      "tab_size": 2,
      "formatter": "auto",
    },
    "TOML": {
      "formatter": {
        "language_server": {
          "name": "tombi"
        }
      }
    },
    "Elixir": {
      "tasks": {
        "prefer_lsp": true,
      },
      "show_edit_predictions": false,
    },
    "JSONC": {
      "tab_size": 2,
    },
    "JSON": {
      "hard_tabs": false,
      "tab_size": 2,
      "formatter": "auto",
    },
    "Go": {
      "show_edit_predictions": false,
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "Rust": {
      "show_edit_predictions": true,
    },
    "C": {
      "show_edit_predictions": false,
    },
    "Python": {
      "language_servers": [
        "ruff",
        "ty"
      ],
      "format_on_save": "on",
      "formatter": [
        {
          "code_action": "source.organizeImports.ruff",
        },
        {
          "code_action": "source.fixAll.ruff",
        },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
    "C++": {
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": [
            "--style=file",
            "--assume-filename={buffer_path}",
          ],
        },
      },
      "format_on_save": "on",
    },
  },
  // --- LSP ---
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 100,
          "lint": {
            "extendSelect": [
              "I"
            ],
          },
        },
      },
    },
    "tinymist": {
      "settings": {
        "projectResolution": "lockDatabase",
        "exportPdf": "onSave",
        "outputPath": "$root/$name",
      },
    },
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "executable": "tectonic",
            "args": [
              "-X",
              "build",
              // "%f",
              // "--synctex",
              "--keep-logs",
              // "--keep-intermediates",
              // "-Zshell-escape",
            ],
            "forwardSearchAfter": false,
            "onSave": true
          }
        }
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": true,
        "check": {
          "command": "clippy",
        },
      },
    },
  },
  // --- SSH Connections ---
  "ssh_connections": [
    {
      "host": "homelab",
      "args": [],
      "projects": [
        {
          "paths": [
            "~/stacks"
          ],
        },
      ],
    },
    {
      "host": "kasdevcontainer.devpod",
      "args": [],
      "projects": [],
    },
    {
      "host": "connect-4",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/marijn/connect-4"
          ],
        },
      ],
    },
  ],
}
