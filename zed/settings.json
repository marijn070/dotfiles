// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  // --- Font ---
  "active_pane_modifiers": {
    "inactive_opacity": 0.6,
  },
  "colorize_brackets": false,
  "experimental.theme_overrides": {
    "background_apperarance": "blurred",
  },
  "minimap": {
    "show": "auto",
  },
  "helix_mode": true,
  "agent_servers": {
    "pi-acp": {
      "default_config_options": {
        "thought_level": "high",
        "model": "cerebras/gemma-4-31b",
      },
      "type": "registry",
    },
    "github-copilot-cli": {
      "default_config_options": {
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent",
        "allow_all": "on",
      },
      "type": "registry",
    },
  },
  "buffer_font_family": "Iosevka Nerd Font",
  "buffer_font_size": 16.0,
  "buffer_font_weight": 400.0,
  "ui_font_family": "Iosevka Aile",
  "ui_font_size": 15.0,
  "ui_font_weight": 450.0,
  "agent_buffer_font_size": 15.0,
  "agent_ui_font_size": 16.0,
  // --- Theme & Icons ---
  "theme": {
    "mode": "dark",
    "light": "Omazed",
    "dark": "Omazed",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark",
  },
  // --- Editor ---
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 8,
  "soft_wrap": "editor_width",
  "diff_view_style": "unified",
  "format_on_save": "on",
  "semantic_tokens": "combined",
  "inlay_hints": {
    "enabled": true,
  },
  "prettier": {
    "allowed": true,
  },
  // --- UI Panels ---
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
    "indent_size": 20.0,
    "folder_icons": true,
    "file_icons": true,
    "entry_spacing": "standard",
  },
  "git_panel": {
    "button": false,
    "dock": "right",
  },
  // --- Agent ---
  "agent": {
    "sandbox_permissions": {
      "network_hosts": ["docs.ros.org"],
    },
    "inline_assistant_model": {
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "enable_thinking": false,
    },
    "sidebar_side": "right",
    "tool_permissions": {
      "tools": {
        "open": {
          "default": "allow",
        },
      },
      "default": "allow",
    },
    "single_file_review": true,
    "default_profile": "write",
    "dock": "right",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
    },
  },
  // --- Edit Predictions ---
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
    },
  },
  // --- Terminal ---
  "terminal": {
    "font_size": 16.0,
    "font_family": "IosevkaTerm Nerd Font",
    "cursor_shape": "block",
    "line_height": "standard",
    "dock": "bottom",
    "shell": {
      "program": "nu",
    },
    "working_directory": "current_project_directory",
    "detect_venv": {
      "on": {
        "directories": [".venv", "venv"],
        "activate_script": "fish",
      },
    },
  },
  // --- Keymaps & Behaviour ---
  "base_keymap": null,
  "cli_default_open_behavior": "new_window",
  "which_key": {
    "enabled": true,
    "delay_ms": 30,
  },
  // --- Languages ---
  "language_models": {
    "openai_compatible": {
      "Cerebras": {
        "api_url": "https://api.cerebras.ai/v1",
        "available_models": [
          {
            "name": "gpt-oss-120b",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 40000,
            "reasoning_effort": "low",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
          {
            "name": "gemma-4-31b",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 40000,
            "reasoning_effort": "low",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false,
            },
          },
        ],
      },
    },
  },
  "file_types": {},
  "languages": {
    "QML": {
      "tab_size": 2,
      // "formatter": "language_server",
    },
    "HTML": {
      "tab_size": 2,
    },
    "Nu": {
      "show_edit_predictions": true,
      "format_on_save": "off",
      "formatter": {
        "external": {
          "command": "nufmt",
          "arguments": ["--stdin"],
        },
      },
    },
    "Gleam": {
      "indent_guides": {
        "background_coloring": "disabled",
        "coloring": "indent_aware",
        "enabled": true,
      },
      "tab_size": 2,
      "show_edit_predictions": false,
    },
    "SQL": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "pg_format",
          "arguments": [
            "--keyword-case",
            "1",
            "--type-case",
            "1",
            "--function-case",
            "1",
            "--spaces",
            "2",
          ],
        },
      },
    },
    "Lua": {
      "tab_size": 4,
    },
    "Shell Script": {
      "tab_size": 4,
    },
    "YAML": {
      "hard_tabs": false,
      "tab_size": 2,
      "formatter": "language_server",
    },
    "XML": {
      "preferred_line_length": 99,
      "tab_size": 2,
      "formatter": "auto",
    },
    "TOML": {
      "tab_size": 4,
      "formatter": {
        "language_server": {
          "name": "tombi",
        },
      },
    },
    "Elixir": {
      "tasks": {
        "prefer_lsp": true,
      },
      "format_on_save": "on",
      "show_edit_predictions": false,
    },
    "JSONC": {
      "tab_size": 2,
    },
    "JSON": {
      "hard_tabs": false,
      "tab_size": 2,
      "formatter": "auto",
    },
    "Go": {
      "show_edit_predictions": false,
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": "language_server",
    },
    "Rust": {
      "show_edit_predictions": true,
    },
    "C": {
      "show_edit_predictions": false,
    },
    "Python": {
      "tab_size": 4,
      "document_symbols": "on",
      "document_folding_ranges": "on",
      "language_servers": ["ruff", "ty"],
      "format_on_save": "on",
      "formatter": "language_server",
    },
    "Typst": {
      "document_folding_ranges": "on",
    },
    "SPARQL": {
      "formatter": {
        "external": {
          "command": "sparql-formatter",
        },
      },
    },
    "C++": {
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": ["--style=file", "--assume-filename={buffer_path}"],
        },
      },
      "format_on_save": "on",
    },
  },
  // --- LSP ---
  "lsp": {
    "qmljs": {
      "binary": {
        "arguments": [
          "-E",
          "-I",
          "/usr/share/omarchy/shell",
          "-I",
          "/home/marijn/.local/share/omarchy-qs",
        ],
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 100,
          "lint": {
            "extendSelect": ["I"],
          },
        },
      },
    },
    "tinymist": {
      "settings": {
        "projectResolution": "lockDatabase",
        "exportPdf": "onSave",
        "outputPath": "$root/$name",
      },
    },
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "executable": "tectonic",
            "args": [
              "-X",
              "build",
              // "%f",
              // "--synctex",
              "--keep-logs",
              // "--keep-intermediates",
              // "-Zshell-escape",
            ],
            "forwardSearchAfter": false,
            "onSave": true,
          },
        },
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": true,
        "check": {
          "command": "clippy",
        },
      },
    },
  },
  // --- SSH Connections ---
  "ssh_connections": [
    {
      "host": "homelab",
      "args": [],
      "projects": [
        {
          "paths": ["~/stacks"],
        },
      ],
    },
    {
      "host": "kasdevcontainer.devpod",
      "args": [],
      "projects": [
        {
          "paths": ["/kas/ws"],
        },
      ],
    },
    {
      "host": "connect-4",
      "args": [],
      "projects": [
        {
          "paths": ["/home/marijn/connect-4"],
        },
      ],
    },
    {
      "host": "perftestws.devpod",
      "args": [],
      "projects": [
        {
          "paths": ["/kas/ws"],
        },
      ],
      "nickname": "triplestar_perf_testing",
    },
  ],
}
