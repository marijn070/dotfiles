// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
    "project_panel": {
        "indent_size": 20.0,
        "folder_icons": true,
        "file_icons": true,
        "entry_spacing": "standard",
    },
    "base_keymap": "JetBrains",
    "buffer_font_family": ".ZedMono",
    "ui_font_family": ".SystemUIFont",
    "icon_theme": "Zed (Default)",
    "language_models": {
        "openai_compatible": {
            "Cerebras": {
                "api_url": "https://api.cerebras.ai/v1/chat/completions",
                "available_models": [
                    {
                        "name": "llama-3.3-70b",
                        "max_tokens": 200000,
                        "max_output_tokens": 32000,
                        "max_completion_tokens": 1024,
                        "capabilities": {
                            "tools": true,
                            "images": false,
                            "parallel_tool_calls": false,
                            "prompt_cache_key": false,
                            "chat_completions": true,
                        },
                    },
                ],
            },
        },
    },
    "which_key": {
        "enabled": true,
    },
    "git_panel": {
        "dock": "right",
    },
    "edit_predictions": {
        "provider": "zed",
        "mode": "subtle",
        "copilot": {
            "proxy": null,
            "proxy_no_verify": null,
        },
        "enabled_in_text_threads": false,
    },
    "inlay_hints": {
        "enabled": true,
    },
    "file_types": {
        "Turtle": ["rq"],
    },
    "ssh_connections": [
        {
            "host": "homelab",
            "args": [],
            "projects": [
                {
                    "paths": ["~/stacks"],
                },
            ],
        },
        {
            "host": "kasdevcontainer.devpod",
            "args": [],
            "projects": [],
        },
    ],
    "format_on_save": "on",
    "languages": {
        "JSONC": {
            "tab_size": 4,
        },
        "JSON": {
            "hard_tabs": false,
            "tab_size": 4,
            "formatter": "auto",
        },
        "Go": {
            "show_edit_predictions": false,
        },
        "Rust": {
            "show_edit_predictions": false,
        },
        "C": {
            "show_edit_predictions": false,
        },
        "Python": {
            "language_servers": ["ruff", "ty"],
            "format_on_save": "on",
            "formatter": [
                {
                    "code_action": "source.organizeImports.ruff",
                },
                {
                    "code_action": "source.fixAll.ruff",
                },
                {
                    "language_server": {
                        "name": "ruff",
                    },
                },
            ],
        },
        "C++": {
            "formatter": {
                "external": {
                    "command": "clang-format",
                    "arguments": [
                        "--style=file",
                        "--assume-filename={buffer_path}",
                    ],
                },
            },
            "format_on_save": "on",
        },
    },
    "lsp": {
        "ruff": {
            "initialization_options": {
                "settings": {
                    "lineLength": 100,
                    "lint": {
                        "extendSelect": ["I"],
                    },
                },
            },
        },
        "rust-analyzer": {
            "initialization_options": {
                "checkOnSave": true,
                "check": {
                    "command": "clippy",
                },
            },
        },
        "yaml-language-server": {
            "initialization_options": {
                "yaml": {
                    "schemaStore": {
                        "enable": false,
                    },
                    "disableAdditionalPropertiesWarnings": [521],
                },
            },
        },
    },
    "terminal": {
        "cursor_shape": "block",
        "dock": "bottom",
        "font_family": "FiraMono Nerd Font Mono",
        "line_height": "standard",
        "shell": {
            "program": "fish",
        },
        "working_directory": "current_project_directory",
        "detect_venv": {
            "on": {
                "directories": [".venv", "venv"],
                "activate_script": "fish",
            },
        },
    },
    "agent": {
        "always_allow_tool_actions": true,
        "single_file_review": true,
        "inline_assistant_model": {
            "provider": "zed.dev",
            "model": "claude-sonnet-4-5",
        },
        "default_profile": "ask",
        "dock": "right",
        "default_model": {
            "provider": "zed.dev",
            "model": "claude-sonnet-4-5",
        },
    },
    "vim_mode": true,
    "relative_line_numbers": "enabled",
    "ui_font_size": 16.0,
    "buffer_font_size": 16.0,
    "vertical_scroll_margin": 8,
    "soft_wrap": "editor_width",
    "theme": "Omazed",
}
